
# ============================================================
# WorkMind API - Git Ignore
# ============================================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build and distribution
build/
dist/
*.egg-info/
.eggs/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking and linting
.mypy_cache/
.ruff_cache/
.pyright/

# Logs
*.log
logs/

# Database files
*.db
*.sqlite
*.sqlite3

# Uploads and generated files
uploads/
storage/
media/

# AI model and embedding caches
models/
model_cache/
.cache/
chroma_db/
vector_db/

# Jupyter
.ipynb_checkpoints/

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Alembic generated bytecode
alembic/__pycache__/
